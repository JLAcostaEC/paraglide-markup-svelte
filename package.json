{
	"name": "@jlacostaec/paraglide-markup-svelte",
	"version": "0.0.1",
	"description": "Type-safe Svelte 5 renderers for Paraglide messages that contain markup, with a default CSS build and a Tailwind build.",
	"keywords": [
		"svelte",
		"svelte5",
		"paraglide",
		"inlang",
		"i18n",
		"markup",
		"tailwindcss"
	],
	"author": {
		"name": "Jorge Acosta",
		"url": "https://github.com/JLAcostaEC"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JLAcostaEC/paraglide-markup-svelte.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "pnpm run build && wrangler pages dev",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright install && playwright test",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:unit": "vitest",
		"deploy": "pnpm run build && wrangler pages deploy",
		"cf-typegen": "wrangler types src/worker-configuration.d.ts",
		"changeset:version": "changeset version && git add --all",
		"changeset:publish": "changeset publish"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/*.spec-d.*",
		"!dist/__tests__",
		"!dist/example.svelte",
		"!dist/example.svelte.d.ts",
		"!dist/paraglide"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./tailwindcss": {
			"types": "./dist/tailwindcss/index.d.ts",
			"svelte": "./dist/tailwindcss/index.js"
		},
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"@inlang/paraglide-js": ">=2.18.2 <3",
		"@inlang/paraglide-js-svelte": "1.0.4",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@inlang/paraglide-js-svelte": "1.0.4",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24.13.3",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.122.0"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.4.0"
}
